rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantUser(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        getUserData().tenantId == tenantId
      );
    }

    // 1. TENANTS (Organizações/Prestadores)
    match /tenants/{tenantId} {
      // Leitura pública permitida para carregar logo e informações no Portal de Solicitação / Aprovação
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isTenantUser(tenantId);
    }

    // 2. USERS (Usuários do sistema)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 3. CLIENTS (Cadastro de Clientes PF/PJ)
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId);
    }

    // 4. PRODUCTS (Catálogo de Peças/Produtos)
    match /products/{productId} {
      allow read, write: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId);
    }

    // 5. SERVICES (Catálogo de Serviços)
    match /services/{serviceId} {
      allow read, write: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId);
    }

    // 6. SERVICE REQUESTS (Chamados/Solicitações)
    match /service_requests/{requestId} {
      // Qualquer cliente final pode criar uma solicitação via portal público
      allow create: if true;
      // Prestador lê e gerencia suas solicitações
      allow read, update, delete: if isAuthenticated() && isTenantUser(resource.data.tenantId);
    }

    // 7. QUOTES (Orçamentos)
    match /quotes/{quoteId} {
      // Leitura pública via link direto (para visualização e aprovação pelo cliente)
      allow read: if true;
      // Atualização pública limitada aos campos de aprovação/recusa
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvalDetails', 'updatedAt'])
                    || (isAuthenticated() && isTenantUser(resource.data.tenantId));
      allow create, delete: if isAuthenticated() && isTenantUser(request.resource.data.tenantId);
    }

    // 8. FINANCIAL TRANSACTIONS (Financeiro)
    match /financial_transactions/{transactionId} {
      allow read, write: if isAuthenticated() && isTenantUser(resource.data.tenantId);
      allow create: if isAuthenticated() && isTenantUser(request.resource.data.tenantId);
    }
  }
}
